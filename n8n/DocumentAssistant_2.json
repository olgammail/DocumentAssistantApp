        "attributes": {
          "attributes": [
            {
              "name": "document_type",
              "description": "Choose exactly one: invoice, request, report, complaint, contract, quote, or other. Choose only based on the content of the document."
            },
            {
              "name": "sender_or_company",
              "description": "Name of the person or organization that explicitly sent, authored, issued, or created the document.  Return a name only when the document clearly identifies that person or organization as the sender, author, issuer, or source.  Do not use a person's or company's name merely because it appears in a meeting title, subject, participant list, filename, link, or other context.  If the sender or organization is not explicitly identifiable, return \"Not found\".  Do not guess or infer the sender."
            },
            {
              "name": "summary",
              "description": "Explain the document in no more than three short sentences. Include only information that appears in the document. Do not invent missing details."
            },
            {
              "name": "requested_action",
              "description": "What should the company do next according to the document? Use \"No action found\" when no requested action appears. Do not invent an action."
            },
            {
              "name": "deadline",
              "description": "Return the deadline exactly as written in the document. Use \"Not found\" when no deadline appears. Do not calculate, reformat, or invent a deadline."
            },
            {
              "name": "urgency",
              "description": "Choose exactly one: Low, Medium, or High. Mark High only when the document contains an immediate deadline, payment risk, legal risk, safety risk, or an explicit urgent request."
            },
            {
              "name": "department",
              "description": "Choose exactly one: Sales, Finance, Support, HR, Management, or General. Choose the department that would most appropriately handle the document."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "Read the document like an office assistant.\n\nExtract only information that is explicitly supported by the document.\n\nDo not invent, guess, assume, or infer missing details.\n\nUse \"Not found\" when information is missing, except for requested_action, where you must use \"No action found\".\n\nFor sender_or_company, return a person or organization only when the document clearly identifies them as the sender, author, issuer, or source. A name appearing in a meeting title, subject, participant list, filename, link, or other context does not prove that they are the sender.\n\nMark urgency as High only when the document contains an immediate deadline, payment risk, legal risk, safety risk, or an explicit urgent request.\n\nFollow the allowed values and instructions defined for every attribute."
        }
      },
